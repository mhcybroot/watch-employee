{
  "manifest_version": 3,
  "name": "Productivity Tracker",
  "version": "1.0",
  "description": "Tracks active tab usage and sends data to backend.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8565/*",
    "http://127.0.0.1:8565/*",
    "http://10.10.10.10:8565/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}