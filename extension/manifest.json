{
  "manifest_version": 3,
  "name": "Productivity Tracker",
  "version": "1.0",
  "description": "Tracks active tab usage and sends data to backend.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8565/*",
    "http://10.10.10.10:8565/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' http://10.10.10.10:8565/ http://localhost:8565/"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "productivity-tracker@example.com",
      "strict_min_version": "109.0"
    }
  }
}