{
  "manifest_version": 3,
  "name": "Productivity Tracker",
  "version": "1.0",
  "description": "Tracks active tab usage and sends data to backend.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "declarativeNetRequest",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:8565/*",
    "http://10.10.10.10:8565/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "credentials.html",
    "default_title": "My Credentials"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://10.10.10.10:8565/ http://localhost:8565/"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "autofill.js"
      ],
      "css": [
        "autofill.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "productivity-tracker@example.com",
      "strict_min_version": "109.0"
    }
  }
}